{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oasis Pendataan Karyawan",
  "version": "1.0.1",
  "identifier": "com.oasis.karyawan",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oasis Pendataan Karyawan",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Apartemen Oasis Mitra Sarana",
    "homepage": "https://github.com/Karuki00/Pendataan-Karyawan-OASIS"
  }
}
