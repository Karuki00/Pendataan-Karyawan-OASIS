{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pendataan Karyawan OASIS",
  "version": "1.2.9",
  "identifier": "com.oasis.karyawan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OASIS One",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Apartemen Oasis Mitra Sarana",
    "homepage": "https://github.com/Karuki00/Pendataan-Karyawan-OASIS",
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.109.0.1518.78.x64/"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERTZFNEE2Mjc0QkIzOTYKUldTV3Mwc25wdVRtUGVBMXVLazYrK2EzNjlzZjZuMCtZTEhxR2NyYnZ5MHh1QjkweUhrc3ZPZVUK",
      "endpoints": [
        "https://github.com/Karuki00/Pendataan-Karyawan-OASIS/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
